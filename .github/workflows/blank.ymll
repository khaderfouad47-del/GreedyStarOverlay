
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.greedystar.analyzer">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"/>

    <application
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:label="Greedy Star Analyzer"
        android:allowBackup="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <service
            android:name=".FloatingService"
            android:exported="false"/>
    </application>
</manifest>

package com.greedystar.analyzer;

import android.app.*;
import android.os.*;
import android.content.*;
import android.graphics.PixelFormat;
import android.view.*;
import android.widget.*;

public class FloatingService extends Service {

    WindowManager wm;
    View floatingView;
    WindowManager.LayoutParams params;

    @Override
    public IBinder onBind(Intent intent) {
        return null;
    }

    @Override
    public void onCreate() {
        super.onCreate();

        wm = (WindowManager)getSystemService(WINDOW_SERVICE);

        LinearLayout panel = new LinearLayout(this);
        panel.setOrientation(1);
        panel.setPadding(15,15,15,15);
        panel.setBackgroundColor(0xff172438);

        TextView title = new TextView(this);
        title.setText("⭐ Greedy Star");
        title.setTextColor(0xffffffff);
        title.setTextSize(18);
        panel.addView(title);

        TextView result = new TextView(this);
        result.setText("المحلل العائم جاهز");
        result.setTextColor(0xff00e5ff);
        result.setTextSize(16);
        panel.addView(result);

        Button close = new Button(this);
        close.setText("إغلاق");
        close.setOnClickListener(v -> stopSelf());
        panel.addView(close);

        floatingView = panel;

        params = new WindowManager.LayoutParams(
            WindowManager.LayoutParams.WRAP_CONTENT,
            WindowManager.LayoutParams.WRAP_CONTENT,
            Build.VERSION.SDK_INT >= 26
                ? WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY
                : WindowManager.LayoutParams.TYPE_PHONE,
            WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE,
            PixelFormat.TRANSLUCENT
        );

        params.gravity = Gravity.TOP | Gravity.RIGHT;
        params.x = 20;
        params.y = 150;

        wm.addView(floatingView, params);

        floatingView.setOnTouchListener(new View.OnTouchListener() {
            int startX,startY;
            float touchX,touchY;

            public boolean onTouch(View v, android.view.MotionEvent e) {
                if(e.getAction()==MotionEvent.ACTION_DOWN){
                    startX=params.x;
                    startY=params.y;
                    touchX=e.getRawX();
                    touchY=e.getRawY();
                    return true;
                }
                if(e.getAction()==MotionEvent.ACTION_MOVE){
                    params.x=startX+(int)(touchX-e.getRawX());
                    params.y=startY+(int)(e.getRawY()-touchY);
                    wm.updateViewLayout(floatingView,params);
                    return true;
                }
                return true;
            }
        });
    }

    @Override
    public void onDestroy() {
        super.onDestroy();
        if(floatingView!=null) wm.removeView(floatingView);
    }
}

package com.greedystar.analyzer;

import android.app.*;
import android.os.*;
import android.content.*;
import android.provider.Settings;
import android.net.Uri;
import android.widget.*;

public class MainActivity extends Activity {

    @Override
    protected void onCreate(Bundle b) {
        super.onCreate(b);

        Button start = new Button(this);
        start.setText("تشغيل النافذة العائمة");

        setContentView(start);

        start.setOnClickListener(v -> {
            if(!Settings.canDrawOverlays(this)){
                Intent permission = new Intent(
                    Settings.ACTION_MANAGE_OVERLAY_PERMISSION,
                    Uri.parse("package:"+getPackageName())
                );
                startActivity(permission);
                return;
            }

            Intent service = new Intent(this,FloatingService.class);
            startService(service);
        });
    }
}
